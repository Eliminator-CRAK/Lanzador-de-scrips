// (Autor: Alex Roman)
// Descripcion: Plantilla de recursos del lanzador nativo.

#include <windows.h>
#include "RecursosLanzador.h"

1 RT_MANIFEST "__RUTA_MANIFIESTO__"
1 ICON "__RUTA_ICONO__"
IDR_APLICACION_DOTNET RCDATA "__RUTA_PAYLOAD__"
IDR_HASH_APLICACION_DOTNET RCDATA "__RUTA_HASH_PAYLOAD__"

1 VERSIONINFO
 FILEVERSION __VERSION_ARCHIVO_COMAS__
 PRODUCTVERSION __VERSION_ARCHIVO_COMAS__
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Aena\0"
            VALUE "FileDescription", "__DESCRIPCION_ARCHIVO__\0"
            VALUE "FileVersion", "__VERSION_ARCHIVO__\0"
            VALUE "InternalName", "__NOMBRE_INTERNO__\0"
            VALUE "LegalCopyright", "Alex Roman\0"
            VALUE "OriginalFilename", "__NOMBRE_ARCHIVO__\0"
            VALUE "ProductName", "LanzadorScripts\0"
            VALUE "ProductVersion", "__VERSION_PRODUCTO__\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
