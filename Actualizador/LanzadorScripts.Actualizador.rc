// Descripcion: Define la version y el icono del actualizador MSI nativo.

#include <windows.h>

1 ICON "..\\Recursos\\IconoLanzador.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,9,0,0
 PRODUCTVERSION 1,9,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Alex Roman\0"
            VALUE "FileDescription", "LanzadorScripts Actualizador\0"
            VALUE "FileVersion", "1.9.0.0\0"
            VALUE "InternalName", "LanzadorScripts.Actualizador\0"
            VALUE "OriginalFilename", "LanzadorScripts.Actualizador.exe\0"
            VALUE "ProductName", "LanzadorScripts\0"
            VALUE "ProductVersion", "1.9.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
