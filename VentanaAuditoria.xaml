<!-- Descripcion: Ventana de consulta de la auditoria almacenada en el servidor central. -->
<Window x:Class="LanzadorScripts.VentanaAuditoria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auditoría de scripts"
        Icon="Recursos/IconoLanzador.ico"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Auditoría de scripts" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="TextoServidor" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Cerrar_Click" Content="Cerrar" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Usuario" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                <ComboBox x:Name="FiltroUsuario" MinHeight="32" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Desde" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                <DatePicker x:Name="FiltroDesde" MinHeight="32" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Hasta" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                <DatePicker x:Name="FiltroHasta" MinHeight="32" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                <TextBlock Text="Resultado" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                <ComboBox x:Name="FiltroResultado" MinHeight="32">
                    <ComboBoxItem Content="Todos" />
                    <ComboBoxItem Content="permitido" />
                    <ComboBoxItem Content="correcto" />
                    <ComboBoxItem Content="error" />
                    <ComboBoxItem Content="denegado" />
                    <ComboBoxItem Content="cancelado" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                <TextBlock Text="Script" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                <TextBox x:Name="FiltroScript" />
            </StackPanel>
            <Button Grid.Column="5" VerticalAlignment="Bottom" Click="Buscar_Click" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" Content="Buscar" />
        </Grid>

        <DataGrid x:Name="TablaAuditoria"
                  Grid.Row="2"
                  Margin="20,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{StaticResource PanelBrush}"
                  Foreground="{StaticResource TextBrush}"
                  BorderBrush="{StaticResource BorderBrushSoft}"
                  RowBackground="{StaticResource PanelBrush}"
                  AlternatingRowBackground="{StaticResource PanelSoftBrush}"
                  HorizontalGridLinesBrush="{StaticResource BorderBrushSubtle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="145" />
                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="185" />
                <DataGridTextColumn Header="Equipo" Binding="{Binding Equipo}" Width="125" />
                <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" Width="190" />
                <DataGridTextColumn Header="Script" Binding="{Binding Script}" Width="190" />
                <DataGridTextColumn Header="Resultado" Binding="{Binding Resultado}" Width="105" />
                <DataGridTextColumn Header="Código" Binding="{Binding CodigoSalida}" Width="65" />
                <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="20,0">
            <TextBlock x:Name="TextoEstado" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
            <ProgressBar x:Name="Progreso" HorizontalAlignment="Right" VerticalAlignment="Center" Width="150" Height="4" IsIndeterminate="True" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
