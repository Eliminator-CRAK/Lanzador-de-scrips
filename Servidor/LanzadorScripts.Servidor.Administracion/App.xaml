<!-- Descripcion: Recursos visuales de la consola del servidor. -->
<Application x:Class="LanzadorScripts.Servidor.Administracion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Fondo" Color="#0D0F12" />
        <SolidColorBrush x:Key="Navegacion" Color="#15181D" />
        <SolidColorBrush x:Key="Superficie" Color="#1B1F25" />
        <SolidColorBrush x:Key="SuperficieAlt" Color="#22272E" />
        <SolidColorBrush x:Key="Borde" Color="#343B44" />
        <SolidColorBrush x:Key="Texto" Color="#F3F4F6" />
        <SolidColorBrush x:Key="TextoSecundario" Color="#9CA3AF" />
        <SolidColorBrush x:Key="Azul" Color="#2563EB" />
        <SolidColorBrush x:Key="Verde" Color="#059669" />
        <SolidColorBrush x:Key="Rojo" Color="#DC2626" />
        <SolidColorBrush x:Key="Ambar" Color="#D97706" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1B1F25" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F3F4F6" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1B1F25" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F3F4F6" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315B8A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6B7280" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource Fondo}" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SuperficieAlt}" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Raiz"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Raiz" Property="Background" Value="#2B323B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Raiz" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101318" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="CaretBrush" Value="{StaticResource Texto}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#101318" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MaxDropDownHeight" Value="300" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="RaizCombo">
                            <Border x:Name="BordeCombo"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid>
                                    <ContentPresenter Margin="9,0,34,0"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      IsHitTestVisible="False"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path Width="8"
                                          Height="5"
                                          Margin="0,0,12,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{TemplateBinding Foreground}"
                                          IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border x:Name="BordeDesplegable"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,3,0,0"
                                        Background="{StaticResource Superficie}"
                                        BorderBrush="{StaticResource Borde}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer Padding="2"
                                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="BordeCombo" Property="BorderBrush" Value="#4B78AA" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="BordeCombo" Property="BorderBrush" Value="#4B78AA" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordeCombo" Property="Background" Value="#171B21" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RaizCombo" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource SuperficieAlt}" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="FondoElementoCombo"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="FondoElementoCombo" Property="Background" Value="#294C73" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FondoElementoCombo" Property="Background" Value="#315B8A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FondoElementoCombo" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotonCalendario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SuperficieAlt}" />
            <Setter Property="Foreground" Value="{StaticResource TextoSecundario}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FondoBotonCalendario"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoBotonCalendario" Property="Background" Value="#2B323B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FondoBotonCalendario" Property="Background" Value="#315B8A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotonNavegacionCalendario" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FondoNavegacionCalendario"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoNavegacionCalendario" Property="Background" Value="#2B323B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FondoNavegacionCalendario" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#101318" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CalendarStyle" Value="{DynamicResource EstiloCalendario}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="PART_Root">
                            <Border x:Name="BordeSelectorFecha"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <DatePickerTextBox x:Name="PART_TextBox"
                                                       Grid.Column="0"
                                                       Margin="1"
                                                       Focusable="{TemplateBinding Focusable}"
                                                       HorizontalContentAlignment="Stretch"
                                                       VerticalContentAlignment="Center" />
                                    <Button x:Name="PART_Button"
                                            Grid.Column="1"
                                            Style="{StaticResource BotonCalendario}"
                                            AutomationProperties.Name="Abrir calendario">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextoSecundario}"
                                                   Text="&#xE787;" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Margin="0,3,0,0"
                                        Background="{StaticResource Superficie}"
                                        BorderBrush="{StaticResource Borde}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Calendar x:Name="PART_Calendar"
                                              Style="{DynamicResource EstiloCalendario}" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="BordeSelectorFecha" Property="BorderBrush" Value="#4B78AA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="CaretBrush" Value="{StaticResource Texto}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EstiloDiaCalendario" TargetType="CalendarDayButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="FondoDia"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="#68707B" />
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="FondoDia" Property="BorderBrush" Value="#4B78AA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FondoDia" Property="Background" Value="#315B8A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoDia" Property="Background" Value="#294C73" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter Property="Foreground" Value="#6B7280" />
                                <Setter TargetName="FondoDia" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FondoDia" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EstiloMesCalendario" TargetType="CalendarButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Border x:Name="FondoMes"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="#68707B" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoMes" Property="Background" Value="#294C73" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FondoMes" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EstiloContenidoCalendario" TargetType="CalendarItem">
            <Setter Property="Background" Value="{StaticResource Superficie}" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <ControlTemplate.Resources>
                            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{StaticResource TextoSecundario}"
                                           Text="{Binding}" />
                            </DataTemplate>
                        </ControlTemplate.Resources>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PART_PreviousButton"
                                            Grid.Column="0"
                                            ToolTip="Mes anterior"
                                            Style="{StaticResource BotonNavegacionCalendario}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76B;" />
                                    </Button>
                                    <Button x:Name="PART_HeaderButton"
                                            Grid.Column="1"
                                            Style="{StaticResource BotonNavegacionCalendario}" />
                                    <Button x:Name="PART_NextButton"
                                            Grid.Column="2"
                                            ToolTip="Mes siguiente"
                                            Style="{StaticResource BotonNavegacionCalendario}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" />
                                    </Button>
                                </Grid>
                                <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                </Grid>
                                <Grid x:Name="PART_YearView" Grid.Row="1" Margin="4" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CalendarDayButton" BasedOn="{StaticResource EstiloDiaCalendario}" />
        <Style TargetType="CalendarButton" BasedOn="{StaticResource EstiloMesCalendario}" />
        <Style TargetType="CalendarItem" BasedOn="{StaticResource EstiloContenidoCalendario}" />
        <Style x:Key="EstiloCalendario" TargetType="Calendar">
            <Setter Property="Background" Value="{StaticResource Superficie}" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource EstiloDiaCalendario}" />
            <Setter Property="CalendarButtonStyle" Value="{StaticResource EstiloMesCalendario}" />
            <Setter Property="CalendarItemStyle" Value="{StaticResource EstiloContenidoCalendario}" />
        </Style>
        <Style TargetType="Calendar" BasedOn="{StaticResource EstiloCalendario}" />
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Superficie}" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="RowBackground" Value="{StaticResource Superficie}" />
            <Setter Property="AlternatingRowBackground" Value="#20252C" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#303640" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#252B33" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="#303640" />
            <Setter Property="Padding" Value="7,5" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#315B8A" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
