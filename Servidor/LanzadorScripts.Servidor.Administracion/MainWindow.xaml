<!-- (Autor: Alex Roman) -->
<!-- Descripcion: Interfaz operativa para administrar el servidor central. -->
<Window x:Class="LanzadorScripts.Servidor.Administracion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanzadorScripts Servidor"
        Icon="Recursos/IconoLanzador.ico"
        Width="1220"
        Height="780"
        MinWidth="980"
        MinHeight="650"
        Background="{StaticResource Fondo}"
        Foreground="{StaticResource Texto}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource Fondo}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Navegacion}" BorderBrush="#2B3038" BorderThickness="0,0,1,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="38" Height="38" Background="#050607" CornerRadius="5">
                        <Image Source="Recursos/IconoLanzador.ico" Width="28" Height="28" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LanzadorScripts" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Servidor 1.8.3" Foreground="{StaticResource TextoSecundario}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="BotonResumen" Click="MostrarResumen_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" /><TextBlock Text="Resumen" /></StackPanel>
                    </Button>
                    <Button x:Name="BotonUsuarios" Click="MostrarUsuarios_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" /><TextBlock Text="Usuarios" /></StackPanel>
                    </Button>
                    <Button x:Name="BotonAuditoria" Click="MostrarAuditoria_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" /><TextBlock Text="Auditoría" /></StackPanel>
                    </Button>
                    <Button x:Name="BotonCatalogo" Click="MostrarCatalogo_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" /><TextBlock Text="Catálogo" /></StackPanel>
                    </Button>
                    <Button x:Name="BotonMantenimiento" Click="MostrarMantenimiento_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" /><TextBlock Text="Mantenimiento" /></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="Sesión administrativa" Foreground="{StaticResource TextoSecundario}" FontSize="11" />
                    <TextBlock x:Name="TextoCuentaActual" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Fondo}" BorderBrush="#292E36" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TituloVista" Text="Resumen del servidor" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock x:Name="SubtituloVista" Text="Estado operativo y controles principales" Foreground="{StaticResource TextoSecundario}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ActualizarTodo_Click" ToolTip="Actualizar datos">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" /><TextBlock Text="Actualizar" /></StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TabControl x:Name="Vistas" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="6" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Servicio Windows" FontWeight="SemiBold" FontSize="15" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Ellipse x:Name="IndicadorServicio" Width="10" Height="10" Fill="{StaticResource Ambar}" Margin="0,0,8,0" />
                                            <TextBlock x:Name="TextoEstadoServicio" Text="Comprobando..." />
                                        </StackPanel>
                                        <TextBlock x:Name="TextoEstadoConexion" Foreground="{StaticResource TextoSecundario}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="BotonInstalarServicio" Click="InstalarServicio_Click" Margin="0,0,8,0" Background="#1E3A5F" BorderBrush="#315B8A" Content="Instalar" />
                                        <Button x:Name="BotonIniciarServicio" Click="IniciarServicio_Click" Margin="0,0,8,0" Background="#123B31" BorderBrush="#1C6B57" Content="Iniciar" />
                                        <Button x:Name="BotonDetenerServicio" Click="DetenerServicio_Click" Margin="0,0,8,0" Background="#4A2525" BorderBrush="#7F3636" Content="Detener" />
                                        <Button x:Name="BotonReiniciarServicio" Click="ReiniciarServicio_Click" Content="Reiniciar" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="4" Margin="0,16,0,0">
                                <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,8,0">
                                    <StackPanel><TextBlock Text="BASE DE DATOS" Foreground="{StaticResource TextoSecundario}" FontSize="11" /><TextBlock x:Name="MetricaBase" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel>
                                </Border>
                                <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="8,0">
                                    <StackPanel><TextBlock Text="USUARIOS" Foreground="{StaticResource TextoSecundario}" FontSize="11" /><TextBlock x:Name="MetricaUsuarios" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel>
                                </Border>
                                <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="8,0">
                                    <StackPanel><TextBlock Text="EVENTOS" Foreground="{StaticResource TextoSecundario}" FontSize="11" /><TextBlock x:Name="MetricaAuditoria" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel>
                                </Border>
                                <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="8,0,0,0">
                                    <StackPanel><TextBlock Text="PUERTO" Foreground="{StaticResource TextoSecundario}" FontSize="11" /><TextBlock x:Name="MetricaPuerto" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Última actividad" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock x:Name="TextoUltimaAuditoria" Text="Sin datos" Foreground="{StaticResource TextoSecundario}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="220" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="TablaUsuarios" SelectionChanged="TablaUsuarios_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cuenta de Windows" Binding="{Binding NombreUsuario}" Width="2*" />
                                <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="110" />
                                <DataGridTextColumn Header="Máximo" Binding="{Binding MaxScriptsSimultaneos}" Width="90" />
                                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="80" />
                                <DataGridTextColumn Header="Carpetas permitidas" Binding="{Binding CarpetasPermitidas.Count}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Cuenta de Windows" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,5" /><TextBox x:Name="CampoCuentaUsuario" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Rol" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,5" /><ComboBox x:Name="CampoRolUsuario"><ComboBoxItem Content="admin" /><ComboBoxItem Content="nominal" /></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Máximo" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,5" /><TextBox x:Name="CampoMaximoUsuario" Text="5" /></StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Carpetas relativas, una por línea" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,5" /><TextBox x:Name="CampoCarpetasUsuario" AcceptsReturn="True" Height="62" VerticalScrollBarVisibility="Auto" /></StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <CheckBox x:Name="CampoUsuarioActivo" Content="Activo" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Click="NuevoUsuario_Click" Content="Nuevo" Margin="0,0,8,0" />
                                    <Button Click="GuardarUsuario_Click" Content="Guardar" Background="#123B31" BorderBrush="#1C6B57" Margin="0,0,8,0" />
                                    <Button Click="EliminarUsuario_Click" Content="Eliminar" Background="#4A2525" BorderBrush="#7F3636" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,9,0"><TextBlock Text="Usuario" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,5" /><ComboBox x:Name="FiltroUsuarioAuditoria" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,9,0"><TextBlock Text="Desde" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,5" /><DatePicker x:Name="FiltroDesdeAuditoria" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,9,0"><TextBlock Text="Hasta" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,5" /><DatePicker x:Name="FiltroHastaAuditoria" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,9,0"><TextBlock Text="Resultado" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,5" /><ComboBox x:Name="FiltroResultadoAuditoria"><ComboBoxItem Content="Todos" /><ComboBoxItem Content="correcto" /><ComboBoxItem Content="error" /><ComboBoxItem Content="denegado" /><ComboBoxItem Content="iniciado" /><ComboBoxItem Content="finalizado" /></ComboBox></StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,9,0"><TextBlock Text="Script" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,5" /><TextBox x:Name="FiltroScriptAuditoria" /></StackPanel>
                            <Button Grid.Column="5" VerticalAlignment="Bottom" Click="BuscarAuditoria_Click" Background="#1E3A5F" BorderBrush="#315B8A">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Buscar" /></StackPanel>
                            </Button>
                        </Grid>
                        <DataGrid x:Name="TablaAuditoria" Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaLocal, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="145" />
                                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="170" />
                                <DataGridTextColumn Header="Equipo" Binding="{Binding Equipo}" Width="120" />
                                <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" Width="190" />
                                <DataGridTextColumn Header="Script" Binding="{Binding Script}" Width="180" />
                                <DataGridTextColumn Header="Resultado" Binding="{Binding Resultado}" Width="100" />
                                <DataGridTextColumn Header="Código" Binding="{Binding CodigoSalida}" Width="70" />
                                <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="TextoEstadoCatalogo" Text="Sin cargar" VerticalAlignment="Center" Foreground="{StaticResource TextoSecundario}" />
                            <Button HorizontalAlignment="Right" Click="CargarCatalogo_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Actualizar" /></StackPanel>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CampoRutaScripts" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Click="SeleccionarCarpetaScripts_Click" Margin="8,0" Content="Examinar" />
                            <Button Grid.Column="2" Click="RegenerarCatalogo_Click" Background="#123B31" BorderBrush="#1C6B57" Content="Recrear catálogo" />
                        </Grid>
                        <DataGrid x:Name="TablaCatalogo" Grid.Row="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Script" Binding="{Binding ScriptId}" Width="2*" />
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Extension}" Width="90" />
                                <DataGridTextColumn Header="Bytes" Binding="{Binding Longitud}" Width="110" />
                                <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="6" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Integridad de la base" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="TextoIntegridad" Text="Sin comprobar" Foreground="{StaticResource TextoSecundario}" Margin="0,7,0,0" /></StackPanel>
                                    <Button Grid.Column="1" Click="ComprobarIntegridad_Click" Content="Comprobar" />
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Copia de seguridad" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="TextoCopia" Text="La copia incluye la base y la clave DPAPI protegida para este servidor." Foreground="{StaticResource TextoSecundario}" Margin="0,7,0,0" /></StackPanel>
                                    <Button Grid.Column="1" Click="CrearCopia_Click" Content="Crear copia" Background="#123B31" BorderBrush="#1C6B57" />
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Servicio Windows" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="La desinstalación del servicio conserva la base y las copias." Foreground="{StaticResource TextoSecundario}" Margin="0,7,0,0" /></StackPanel>
                                    <Button Grid.Column="1" Click="DesinstalarServicio_Click" Content="Desinstalar servicio" Background="#4A2525" BorderBrush="#7F3636" />
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Rutas locales" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TextoRutasServidor" Foreground="{StaticResource TextoSecundario}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="#111419" BorderBrush="#292E36" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid>
                    <TextBlock x:Name="TextoEstadoOperacion" Text="Listo" Foreground="{StaticResource TextoSecundario}" VerticalAlignment="Center" />
                    <ProgressBar x:Name="ProgresoOperacion" IsIndeterminate="True" Width="120" Height="4" HorizontalAlignment="Right" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
