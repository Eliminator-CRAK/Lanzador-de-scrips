<!-- (Autor: Alex Roman) -->
<!-- Descripcion: Proyecto WPF del lanzador de scripts PowerShell. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>manifiesto.manifest</ApplicationManifest>
    <ApplicationIcon>Recursos\IconoLanzador.ico</ApplicationIcon>
    <AssemblyName>LanzadorScripts</AssemblyName>
    <RootNamespace>LanzadorScripts</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
    <ErrorOnDuplicatePublishOutputFiles>true</ErrorOnDuplicatePublishOutputFiles>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions></AllowedReferenceRelatedFileExtensions>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <LANZADOR_GIT_REVISION Condition="'$(LANZADOR_GIT_REVISION)' == ''">dev</LANZADOR_GIT_REVISION>
  </PropertyGroup>

  <ItemGroup>
    <Page Remove="Aplicacion.xaml" />
    <ApplicationDefinition Include="Aplicacion.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Compartido\LanzadorScripts.Protocolo\LanzadorScripts.Protocolo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ConfiguracionPredeterminada.json" />
    <Resource Include="Recursos\IconoLanzador.ico" />
    <Resource Include="Recursos\IconoLanzador.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeInstalledUpdater)' == 'true' and Exists('$(InstalledUpdaterSource)')">
    <Content Include="$(InstalledUpdaterSource)">
      <Link>LanzadorScripts.Actualizador.exe</Link>
      <TargetPath>LanzadorScripts.Actualizador.exe</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Compile Remove="Pruebas\**\*.cs" />
    <Compile Remove="Compartido\**\*.cs" />
    <Compile Remove="Servidor\**\*.cs" />
    <Page Remove="Compartido\**\*.xaml" />
    <Page Remove="Servidor\**\*.xaml" />
    <ApplicationDefinition Remove="Compartido\**\*.xaml" />
    <ApplicationDefinition Remove="Servidor\**\*.xaml" />
    <EmbeddedResource Remove="Compartido\**\*" />
    <EmbeddedResource Remove="Servidor\**\*" />
    <None Remove="Compartido\**\*" />
    <None Remove="Servidor\**\*" />
  </ItemGroup>

  <Target Name="PrepararPublishItemsInstalador" BeforeTargets="PublishItemsOutputGroup">
    <ItemGroup>
      <EjecutablePublishItems Include="@(ResolvedFileToPublish)"
                              Condition="'%(ResolvedFileToPublish.RelativePath)' == 'LanzadorScripts.exe'" />
    </ItemGroup>
    <Error Condition="'$(FirmarPublicacionInstalada)' == 'true' and '$(LANZADOR_SIGNING_THUMBPRINT)' != '' and '@(EjecutablePublishItems->Count())' != '1'"
           Text="Publish Items no contiene exactamente un ejecutable principal para firmar." />
    <Exec Condition="'$(FirmarPublicacionInstalada)' == 'true' and '$(LANZADOR_SIGNING_THUMBPRINT)' != ''"
          Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\Herramientas\FirmarPublicacionInstalada.ps1&quot; -RutaArchivo &quot;@(EjecutablePublishItems->'%(FullPath)')&quot; -Thumbprint &quot;$(LANZADOR_SIGNING_THUMBPRINT)&quot; -TimestampServer &quot;$(LANZADOR_TIMESTAMP_SERVER)&quot;" />
  </Target>

  <Target Name="ValidarActualizadorInstalado"
          BeforeTargets="ComputeFilesToPublish"
          Condition="'$(IncludeInstalledUpdater)' == 'true' and !Exists('$(InstalledUpdaterSource)')">
    <Error Text="No se encontro el actualizador nativo en $(InstalledUpdaterSource)." />
  </Target>

  <Target Name="FirmarEjecutableInstalado"
          AfterTargets="Publish"
          Condition="'$(FirmarPublicacionInstalada)' == 'true' and '$(LANZADOR_SIGNING_THUMBPRINT)' != ''">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\Herramientas\FirmarPublicacionInstalada.ps1&quot; -RutaArchivo &quot;$(PublishDir)LanzadorScripts.exe&quot; -Thumbprint &quot;$(LANZADOR_SIGNING_THUMBPRINT)&quot; -TimestampServer &quot;$(LANZADOR_TIMESTAMP_SERVER)&quot;" />
  </Target>

</Project>
