<!-- Descripcion: Proyecto WPF del lanzador de scripts PowerShell. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>manifiesto.manifest</ApplicationManifest>
    <AssemblyName>LanzadorScripts</AssemblyName>
    <RootNamespace>LanzadorScripts</RootNamespace>
    <Version>1.4.5</Version>
    <AssemblyVersion>1.4.5.0</AssemblyVersion>
    <FileVersion>1.4.5.0</FileVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
    <ErrorOnDuplicatePublishOutputFiles>true</ErrorOnDuplicatePublishOutputFiles>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions></AllowedReferenceRelatedFileExtensions>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <WebView2RuntimeZip>$(BaseIntermediateOutputPath)WebView2Runtime\WebView2Runtime.zip</WebView2RuntimeZip>
  </PropertyGroup>

  <ItemGroup>
    <Page Remove="Aplicacion.xaml" />
    <ApplicationDefinition Include="Aplicacion.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ConfiguracionPredeterminada.json" />
    <EmbeddedResource Include="ClienteWeb\**\*">
      <LogicalName>ClienteWeb.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(WebView2RuntimeZip)" Condition="Exists('$(WebView2RuntimeZip)')">
      <LogicalName>Recursos.WebView2Runtime.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Pruebas\**\*.cs" />
  </ItemGroup>

  <Target Name="EliminarDocumentacionWebView2Publicada" AfterTargets="Publish">
    <ItemGroup>
      <DocumentacionWebView2 Include="$(PublishDir)Microsoft.Web.WebView2*.xml" />
    </ItemGroup>
    <Delete Files="@(DocumentacionWebView2)" />
  </Target>

</Project>
