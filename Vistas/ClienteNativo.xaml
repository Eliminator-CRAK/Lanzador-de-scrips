<!-- (Autor: Alex Roman) -->
<!-- Descripcion: Catalogo, consolas y ajustes con controles WPF nativos. -->
<UserControl x:Class="LanzadorScripts.Vistas.ClienteNativo"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vistas="clr-namespace:LanzadorScripts.Vistas" Background="{StaticResource SurfaceBrush}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleSi" />
  <vistas:InvertirBooleano x:Key="InvertirBooleano" />
  <vistas:AlturaConsolasNativas x:Key="AlturaConsolas" />
  <vistas:ColumnasConsolasNativas x:Key="ColumnasConsolas" />
  <vistas:TextoEjecucionesScript x:Key="EjecucionesScript" />
  <Style x:Key="BotonIconoNativo" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="7"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
  <Border BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
   <Grid Margin="24,0">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="SaludoUsuario" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Usuario}" Margin="0,0,20,0"><Run Text="Hola, "/><Run Text="{Binding Usuario, Mode=OneWay}"/></TextBlock>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="BotonDetenerTodas" Click="DetenerTodas_Click" IsEnabled="{Binding PuedeDetenerTodas}" Background="Transparent" BorderBrush="{StaticResource DangerBrush}" Foreground="{StaticResource DangerBrush}" ToolTip="Detener todas las ejecuciones conservando su salida" AutomationProperties.Name="Detener todas las ejecuciones" Margin="0,0,16,0">
      <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconoCuadrado}" Style="{StaticResource EstiloIcono}" Stroke="{StaticResource DangerBrush}" Width="14" Height="14" Margin="0,0,7,0"/><TextBlock Text="Detener todo"/></StackPanel>
     </Button>
     <TextBlock Text="Ejecutando:" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
     <Border Background="{StaticResource PanelAltBrush}" CornerRadius="4" MinWidth="30" Padding="7,4" Margin="7,0,12,0"><TextBlock x:Name="ContadorActivas" Text="{Binding Activas}" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" TextAlignment="Center"/></Border>
     <TextBlock Text="Max:" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
     <Border Background="{StaticResource PanelAltBrush}" CornerRadius="4" MinWidth="30" Padding="7,4" Margin="7,0,12,0"><TextBlock Text="{Binding Limite}" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" TextAlignment="Center"/></Border>
     <Button x:Name="BotonLimpiarFinalizadas" Style="{StaticResource BotonIconoNativo}" Click="Limpiar_Click" IsEnabled="{Binding PuedeLimpiarFinalizadas}" ToolTip="Cerrar solo las consolas finalizadas" AutomationProperties.Name="Limpiar consolas finalizadas" Margin="0,0,8,0"><Path Data="{StaticResource IconoPapelera}" Style="{StaticResource EstiloIcono}" Stroke="{StaticResource MutedTextBrush}"/></Button>
     <Button x:Name="BotonAuditoria" Style="{StaticResource BotonIconoNativo}" Click="Auditoria_Click" Visibility="{Binding Administrador, Converter={StaticResource VisibleSi}}" ToolTip="Auditoria" AutomationProperties.Name="Abrir auditoria"><Path Data="{StaticResource IconoRegistro}" Style="{StaticResource EstiloIcono}" Stroke="{StaticResource MutedTextBrush}"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding AjustesAbiertos}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Margin="24,0,16,0">
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
     <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0">
      <Grid>
       <TextBlock Text="Buscar scripts..." Margin="32,0,32,0" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Buscar}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBox x:Name="BuscadorScripts" Text="{Binding Buscar, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Background="Transparent" BorderThickness="0" Padding="32,6,32,6" VerticalContentAlignment="Center" AutomationProperties.Name="Buscar scripts" ToolTip="Buscar scripts"/>
       <Path Data="{StaticResource IconoBuscar}" Style="{StaticResource EstiloIcono}" Stroke="{StaticResource DimTextBrush}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
       <Button Click="VaciarBusqueda_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="9" ToolTip="Borrar busqueda" AutomationProperties.Name="Borrar busqueda"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource BotonIconoNativo}"><Style.Triggers><DataTrigger Binding="{Binding Buscar}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style><Path Data="{StaticResource IconoCerrar}" Style="{StaticResource EstiloIcono}" Stroke="{StaticResource DimTextBrush}" Width="12" Height="12"/></Button>
      </Grid>
     </Border>
     <Button Grid.Column="1" Style="{StaticResource BotonIconoNativo}" Click="Refrescar_Click" ToolTip="Actualizar scripts" AutomationProperties.Name="Actualizar scripts" HorizontalAlignment="Right"><Path Data="{StaticResource IconoRefrescar}" Style="{StaticResource EstiloIcono}" Stroke="{StaticResource MutedTextBrush}"/></Button>
    </Grid>
    <Grid Grid.Row="1" Margin="0,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource BotonIconoNativo}" Click="Subir_Click" ToolTip="Subir carpeta" AutomationProperties.Name="Subir carpeta"><TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"/></Button>
     <TextBlock Grid.Column="1" Text="{Binding Carpeta}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Carpeta}"/>
    </Grid>
    <ListBox Grid.Row="2" x:Name="ListadoScripts" ItemsSource="{Binding Scripts}" Background="Transparent" BorderThickness="0" MouseDoubleClick="ListadoScripts_DobleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ContextMenu><ContextMenu><MenuItem Header="Diagnostico de ejecucion" Click="Diagnostico_Click"/></ContextMenu></ListBox.ContextMenu>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Seleccion" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Seleccion" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Seleccion" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="8" Padding="12" ToolTip="{Binding MotivoBloqueo}">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Width="30" Height="30" Background="{StaticResource AccentSoftBrush}" CornerRadius="6" VerticalAlignment="Top"><Path Data="{StaticResource IconoTerminal}" Style="{StaticResource EstiloIcono}" Stroke="{StaticResource AccentBrush}" Width="19" Height="19"/></Border>
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Nombre}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12"/>
          <TextBlock Text="{Binding Tipo}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,0"/>
          <TextBlock Text="{Binding Carpeta}" Foreground="{StaticResource DimTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
         </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,7,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource EjecucionesScript}"><Binding Path="Id"/><Binding Path="DataContext.Activas" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/><Binding Path="DataContext.Consolas" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/></MultiBinding></TextBlock.Text><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Button Grid.Row="2" Tag="{Binding}" Click="Ejecutar_Click" VerticalAlignment="Center" ToolTip="Ejecutar o abrir" AutomationProperties.Name="Ejecutar o abrir script" Margin="0,12,0,0" Padding="8,6">
         <Button.IsEnabled><Binding Path="EstaBloqueado" Converter="{StaticResource InvertirBooleano}"/></Button.IsEnabled>
         <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconoPlay}" Style="{StaticResource EstiloIcono}" Stroke="{StaticResource MutedTextBrush}" Width="13" Height="13" Margin="0,0,7,0"/><TextBlock Foreground="{StaticResource MutedTextBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Ejecutar script"/><Style.Triggers><DataTrigger Binding="{Binding EsCarpeta}" Value="True"><Setter Property="Text" Value="Abrir carpeta"/></DataTrigger><DataTrigger Binding="{Binding EstaBloqueado}" Value="True"><Setter Property="Text" Value="Bloqueado"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
        </Button>
       </Grid>
      </Border>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Click="Ajustes_Click" Style="{StaticResource BotonMenu}" Visibility="{Binding Administrador, Converter={StaticResource VisibleSi}}" AutomationProperties.Name="Configuracion avanzada" Padding="0,8">
      <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconoAjustes}" Style="{StaticResource EstiloIcono}" Stroke="{StaticResource MutedTextBrush}" Margin="0,0,8,0"/><TextBlock Text="Configuracion avanzada" FontSize="11"/></StackPanel>
     </Button>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Administrador}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Path Data="{StaticResource IconoBloqueo}" Style="{StaticResource EstiloIcono}" Stroke="{StaticResource DimTextBrush}" Width="13" Height="13" Margin="0,0,6,0"/><TextBlock Text="Sin permisos de configuracion" Foreground="{StaticResource DimTextBrush}" FontSize="10"/></StackPanel>
     <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="10" Foreground="{StaticResource DimTextBrush}" FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0"/>
    </Grid>
   </Grid>
   <ScrollViewer Grid.Column="1" x:Name="DesplazamientoConsolas" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Consolas}">
     <!-- Acota la salida y mantiene la entrada visible dentro de cada consola. -->
     <ItemsControl.Height><MultiBinding Converter="{StaticResource AlturaConsolas}"><Binding Path="ViewportHeight" ElementName="DesplazamientoConsolas"/><Binding Path="Consolas.Count"/><Binding Path="ActualWidth" ElementName="DesplazamientoConsolas"/></MultiBinding></ItemsControl.Height>
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid><UniformGrid.Columns><MultiBinding Converter="{StaticResource ColumnasConsolas}"><Binding Path="Consolas.Count"/><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type ScrollViewer}}"/></MultiBinding></UniformGrid.Columns></UniformGrid></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><vistas:ConsolaNativa MinHeight="280" Margin="0,0,12,12" Enviar="Consola_Enviar" Cerrar="Consola_Cerrar"/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
  </Grid>
  <Grid Grid.Row="1" Margin="24,8,24,16" Visibility="{Binding AjustesAbiertos, Converter={StaticResource VisibleSi}}">
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
   <Grid><TextBlock Text="Configuracion avanzada" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><Button HorizontalAlignment="Right" Click="Volver_Click" Content="Volver"/></Grid>
   <TabControl Grid.Row="1" x:Name="PestanasAjustes" Background="{StaticResource SurfaceBrush}" BorderThickness="0" Foreground="{StaticResource TextBrush}">
    <TabItem Header="Usuarios">
     <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <DataGrid x:Name="TablaUsuarios" ItemsSource="{Binding Usuarios}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource PanelSoftBrush}" GridLinesVisibility="None" HeadersVisibility="Column">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Usuario Windows" Binding="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="240"/>
        <DataGridTemplateColumn Header="Rol" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox SelectedValue="{Binding Rol, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag"><ComboBoxItem Content="Nominal" Tag="nominal"/><ComboBoxItem Content="Administrador" Tag="admin"/></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Maximo" Binding="{Binding MaxScriptsSimultaneos, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="80"/>
        <DataGridTemplateColumn Header="Carpetas" Width="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding ResumenCarpetas}" Tag="{Binding}" Click="CarpetasUsuario_Click" ToolTip="Seleccionar carpetas permitidas"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Tag="{Binding}" Click="EliminarUsuario_Click" ToolTip="Eliminar usuario" AutomationProperties.Name="Eliminar usuario" Style="{StaticResource BotonIconoNativo}"><Path Data="{StaticResource IconoCerrar}" Style="{StaticResource EstiloIcono}"/></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <Button Grid.Row="1" HorizontalAlignment="Left" Click="AgregarUsuario_Click" Content="Agregar usuario" Margin="0,6,0,0"/>
     </Grid>
    </TabItem>
    <TabItem Header="Seguridad">
     <StackPanel Margin="0,18">
      <CheckBox Content="Permitir ExecutionPolicy Bypass" IsChecked="{Binding PermitirBypass}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>
      <Button Content="Scripts elevados permitidos" HorizontalAlignment="Left" Click="Elevados_Click" Margin="0,0,0,12"/>
      <Button Content="Scripts reservados a administradores" HorizontalAlignment="Left" Click="ScriptsAdmin_Click" Margin="0,0,0,18"/>
      <CheckBox x:Name="ModoDesarrollo" Content="Modo desarrollo de firmas (sesion)" IsChecked="{Binding ModoDesarrollo, Mode=OneWay}" Click="ModoDesarrollo_Click" Foreground="{StaticResource TextBrush}" Margin="0,0,0,18"/>
      <Button Content="Aplicar ExecutionPolicy Unrestricted" HorizontalAlignment="Left" Click="ExecutionPolicy_Click"/>
     </StackPanel>
    </TabItem>
    <TabItem Header="Catalogo">
     <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <DataGrid x:Name="TablaCatalogo" ItemsSource="{Binding Catalogo}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" RowBackground="{StaticResource PanelBrush}" GridLinesVisibility="None" HeadersVisibility="Column">
       <DataGrid.Columns><DataGridCheckBoxColumn Header="Incluir" Binding="{Binding Incluido, UpdateSourceTrigger=PropertyChanged}" Width="60"/><DataGridTextColumn Header="Script" Binding="{Binding ScriptId}" IsReadOnly="True" Width="*" MinWidth="260"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" IsReadOnly="True" Width="220"/></DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"><Button Click="RefrescarCatalogo_Click" Content="Actualizar" Margin="0,0,8,0"/><Button Click="PublicarCatalogo_Click" Content="Publicar catalogo"/></StackPanel>
     </Grid>
    </TabItem>
    <TabItem Header="Conexion"><StackPanel Margin="0,18"><TextBlock Text="Servidor central" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="ServidorCentral" Foreground="{StaticResource TextBrush}" Margin="0,6,0,18"/><TextBlock Text="Carpeta de scripts" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding RutaScripts}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,18"/><Button Click="Auditoria_Click" Content="Auditoria" HorizontalAlignment="Left"/></StackPanel></TabItem>
   </TabControl>
   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Click="Volver_Click" Content="Descartar cambios" Margin="0,0,8,0"/><Button x:Name="BotonGuardar" Click="Guardar_Click" Content="Guardar cambios" Background="{StaticResource AccentSoftBrush}"/></StackPanel>
  </Grid>
  <TextBlock Grid.Row="2" Margin="24,0" Text="{Binding Estado}" FontSize="11" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Estado}"/>
  <ProgressBar Grid.Row="0" Grid.RowSpan="3" Height="3" VerticalAlignment="Top" IsIndeterminate="True" Visibility="{Binding Cargando, Converter={StaticResource VisibleSi}}"/>
 </Grid>
</UserControl>
