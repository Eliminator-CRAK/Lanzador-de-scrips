<!-- (Autor: Alex Roman) -->
<!-- Descripcion: Catalogo, consolas y ajustes con controles WPF nativos. -->
<UserControl x:Class="LanzadorScripts.Vistas.ClienteNativo"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vistas="clr-namespace:LanzadorScripts.Vistas" Background="{StaticResource SurfaceBrush}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleSi" />
  <vistas:InvertirBooleano x:Key="InvertirBooleano" />
  <Style x:Key="BotonIconoNativo" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="7"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Grid Margin="20,0" >
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Path Data="{StaticResource IconoTerminal}" Style="{StaticResource EstiloIcono}" Stroke="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
    <TextBlock Text="{Binding Usuario}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="{Binding Resumen}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0"/>
   <Button Grid.Column="2" Style="{StaticResource BotonIconoNativo}" Click="Limpiar_Click" ToolTip="Cerrar consolas finalizadas y detener ejecuciones" AutomationProperties.Name="Limpiar consolas">
    <Path Data="{StaticResource IconoCerrar}" Style="{StaticResource EstiloIcono}"/>
   </Button>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding AjustesAbiertos}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Margin="16,0,12,0">
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
     <TextBox Text="{Binding Buscar, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" VerticalContentAlignment="Center" AutomationProperties.Name="Buscar scripts" ToolTip="Buscar scripts"/>
     <Button Grid.Column="1" Style="{StaticResource BotonIconoNativo}" Click="Refrescar_Click" ToolTip="Actualizar scripts" AutomationProperties.Name="Actualizar scripts"><Path Data="{StaticResource IconoRefrescar}" Style="{StaticResource EstiloIcono}"/></Button>
    </Grid>
    <Grid Grid.Row="1" Margin="0,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource BotonIconoNativo}" Click="Subir_Click" ToolTip="Subir carpeta" AutomationProperties.Name="Subir carpeta"><TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"/></Button>
     <TextBlock Grid.Column="1" Text="{Binding Carpeta}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Carpeta}"/>
    </Grid>
    <ListBox Grid.Row="2" x:Name="ListadoScripts" ItemsSource="{Binding Scripts}" Background="Transparent" BorderThickness="0" MouseDoubleClick="ListadoScripts_DobleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ContextMenu><ContextMenu><MenuItem Header="Diagnostico de ejecucion" Click="Diagnostico_Click"/></ContextMenu></ListBox.ContextMenu>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="8" Padding="12" ToolTip="{Binding MotivoBloqueo}">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0">
         <TextBlock Text="{Binding Nombre}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Tipo}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/>
         <TextBlock Text="{Binding Carpeta}" Foreground="{StaticResource DimTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" Tag="{Binding}" Style="{StaticResource BotonIconoNativo}" Click="Ejecutar_Click" VerticalAlignment="Center" ToolTip="Ejecutar o abrir" AutomationProperties.Name="Ejecutar o abrir script">
         <Button.IsEnabled><Binding Path="EstaBloqueado" Converter="{StaticResource InvertirBooleano}"/></Button.IsEnabled>
         <Path Data="{StaticResource IconoPlay}" Style="{StaticResource EstiloIcono}" Stroke="{StaticResource AccentBrush}"/>
        </Button>
       </Grid>
      </Border>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Button Grid.Row="3" Click="Ajustes_Click" Style="{StaticResource BotonMenu}" Visibility="{Binding Administrador, Converter={StaticResource VisibleSi}}">
     <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconoAjustes}" Style="{StaticResource EstiloIcono}" Margin="0,0,8,0"/><TextBlock Text="Configuracion avanzada"/></StackPanel>
    </Button>
   </Grid>
   <ScrollViewer Grid.Column="1" x:Name="DesplazamientoConsolas" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Consolas}" MinHeight="{Binding ViewportHeight, ElementName=DesplazamientoConsolas}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><vistas:ConsolaNativa MinHeight="280" Margin="0,0,0,12" Enviar="Consola_Enviar" Cerrar="Consola_Cerrar"/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
  </Grid>
  <Grid Grid.Row="1" Margin="24,8,24,16" Visibility="{Binding AjustesAbiertos, Converter={StaticResource VisibleSi}}">
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
   <Grid><TextBlock Text="Configuracion avanzada" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><Button HorizontalAlignment="Right" Click="Volver_Click" Content="Volver"/></Grid>
   <TabControl Grid.Row="1" x:Name="PestanasAjustes" Background="{StaticResource SurfaceBrush}" BorderThickness="0" Foreground="{StaticResource TextBrush}">
    <TabItem Header="Usuarios">
     <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <DataGrid x:Name="TablaUsuarios" ItemsSource="{Binding Usuarios}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource PanelSoftBrush}" GridLinesVisibility="None" HeadersVisibility="Column">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Usuario Windows" Binding="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="240"/>
        <DataGridTemplateColumn Header="Rol" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox SelectedValue="{Binding Rol, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag"><ComboBoxItem Content="Nominal" Tag="nominal"/><ComboBoxItem Content="Administrador" Tag="admin"/></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Maximo" Binding="{Binding MaxScriptsSimultaneos, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="80"/>
        <DataGridTemplateColumn Header="Carpetas" Width="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding ResumenCarpetas}" Tag="{Binding}" Click="CarpetasUsuario_Click" ToolTip="Seleccionar carpetas permitidas"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Tag="{Binding}" Click="EliminarUsuario_Click" ToolTip="Eliminar usuario" AutomationProperties.Name="Eliminar usuario" Style="{StaticResource BotonIconoNativo}"><Path Data="{StaticResource IconoCerrar}" Style="{StaticResource EstiloIcono}"/></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <Button Grid.Row="1" HorizontalAlignment="Left" Click="AgregarUsuario_Click" Content="Agregar usuario" Margin="0,6,0,0"/>
     </Grid>
    </TabItem>
    <TabItem Header="Seguridad">
     <StackPanel Margin="0,18">
      <CheckBox Content="Permitir ExecutionPolicy Bypass" IsChecked="{Binding PermitirBypass}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>
      <Button Content="Scripts elevados permitidos" HorizontalAlignment="Left" Click="Elevados_Click" Margin="0,0,0,12"/>
      <Button Content="Scripts reservados a administradores" HorizontalAlignment="Left" Click="ScriptsAdmin_Click" Margin="0,0,0,18"/>
      <CheckBox x:Name="ModoDesarrollo" Content="Modo desarrollo de firmas (sesion)" IsChecked="{Binding ModoDesarrollo, Mode=OneWay}" Click="ModoDesarrollo_Click" Foreground="{StaticResource TextBrush}" Margin="0,0,0,18"/>
      <Button Content="Aplicar ExecutionPolicy Unrestricted" HorizontalAlignment="Left" Click="ExecutionPolicy_Click"/>
     </StackPanel>
    </TabItem>
    <TabItem Header="Catalogo">
     <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <DataGrid x:Name="TablaCatalogo" ItemsSource="{Binding Catalogo}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" RowBackground="{StaticResource PanelBrush}" GridLinesVisibility="None" HeadersVisibility="Column">
       <DataGrid.Columns><DataGridCheckBoxColumn Header="Incluir" Binding="{Binding Incluido, UpdateSourceTrigger=PropertyChanged}" Width="60"/><DataGridTextColumn Header="Script" Binding="{Binding ScriptId}" IsReadOnly="True" Width="*" MinWidth="260"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" IsReadOnly="True" Width="220"/></DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"><Button Click="RefrescarCatalogo_Click" Content="Actualizar" Margin="0,0,8,0"/><Button Click="PublicarCatalogo_Click" Content="Publicar catalogo"/></StackPanel>
     </Grid>
    </TabItem>
    <TabItem Header="Conexion"><StackPanel Margin="0,18"><TextBlock Text="Servidor central" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="ServidorCentral" Foreground="{StaticResource TextBrush}" Margin="0,6,0,18"/><TextBlock Text="Carpeta de scripts" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding RutaScripts}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,18"/><Button Click="Auditoria_Click" Content="Auditoria" HorizontalAlignment="Left"/></StackPanel></TabItem>
   </TabControl>
   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Click="Volver_Click" Content="Descartar cambios" Margin="0,0,8,0"/><Button x:Name="BotonGuardar" Click="Guardar_Click" Content="Guardar cambios" Background="{StaticResource AccentSoftBrush}"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Estado}" FontSize="11" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Estado}"/><TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="10" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center"/></Grid>
  <ProgressBar Grid.Row="0" Grid.RowSpan="3" Height="3" VerticalAlignment="Top" IsIndeterminate="True" Visibility="{Binding Cargando, Converter={StaticResource VisibleSi}}"/>
 </Grid>
</UserControl>
