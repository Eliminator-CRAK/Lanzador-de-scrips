<!-- (Autor: Alex Roman) -->
<!-- Descripcion: Contenedor WPF del cliente web original. -->
<Window x:Class="LanzadorScripts.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lanzador de Scripts"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0F1115"
        BorderThickness="0"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BotonVentanaMac" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#66000000" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}"
                              Background="Transparent">
                            <Border x:Name="AnilloFoco"
                                    Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            <Ellipse x:Name="Circulo"
                                     Width="14"
                                     Height="14"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="#33000000"
                                     StrokeThickness="0.5"
                                     Opacity="0.96"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="Simbolo"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circulo" Property="Opacity" Value="1" />
                                <Setter TargetName="Simbolo" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circulo" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="AnilloFoco" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0F1115"
            BorderThickness="0"
            CornerRadius="12">
        <Grid Background="#0F1115">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="BarraTitulo"
              Grid.Row="0"
              Background="#111827"
              MouseLeftButtonDown="BarraTitulo_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Button x:Name="BotonCerrar"
                        Style="{StaticResource BotonVentanaMac}"
                        Background="#FF5F57"
                        Tag="x"
                        Click="BotonCerrar_Click"
                        ToolTip="Cerrar"
                        AutomationProperties.Name="Cerrar ventana" />
                <Button x:Name="BotonMinimizar"
                        Style="{StaticResource BotonVentanaMac}"
                        Background="#FFBD2E"
                        Margin="9,0,0,0"
                        Tag="-"
                        Click="BotonMinimizar_Click"
                        ToolTip="Minimizar"
                        AutomationProperties.Name="Minimizar ventana" />
                <Button x:Name="BotonMaximizar"
                        Style="{StaticResource BotonVentanaMac}"
                        Background="#28C840"
                        Margin="9,0,0,0"
                        Tag="+"
                        Click="BotonMaximizar_Click"
                        ToolTip="Maximizar"
                        AutomationProperties.Name="Maximizar o restaurar ventana" />
            </StackPanel>

            <TextBlock Text="Lanzador de Scripts"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#6B7280"
                       FontSize="11"
                       FontWeight="SemiBold" />
        </Grid>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="VistaCliente"
                          AutomationProperties.Name="Cliente web del lanzador de scripts" />
            <Border x:Name="PanelArranque"
                    Background="#0F1115"
                    Padding="32"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="520">
                    <TextBlock Text="Preparando Lanzador de Scripts"
                               Foreground="#F9FAFB"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                    <TextBlock x:Name="TextoArranque"
                               Text="Inicializando WebView2 y servidor local..."
                               Foreground="#9CA3AF"
                               FontSize="13"
                               Margin="0,14,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,22,0,0"
                                 Foreground="#60A5FA"
                                 Background="#1F2937" />
                    <TextBlock Text="Los detalles tecnicos se registran en la carpeta local de logs."
                               Foreground="#6B7280"
                               FontSize="12"
                               Margin="0,18,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button x:Name="BotonReintentarArranque"
                            Content="Reintentar"
                            Width="128"
                            Height="34"
                            Margin="0,18,0,0"
                            Visibility="Collapsed"
                            Click="BotonReintentarArranque_Click"
                            AutomationProperties.Name="Reintentar arranque del cliente web" />
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Border>
</Window>
