<!-- (Autor: Alex Roman) -->
<!-- Descripcion: Confirma el cierre definitivo y muestra los scripts activos. -->
<Window x:Class="LanzadorScripts.DialogoCerrarAplicacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cerrar LanzadorScripts"
        Width="540"
        Height="420"
        MinWidth="460"
        MinHeight="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="#0F1115"
        Foreground="#F3F4F6"
        Icon="Recursos/IconoLanzador.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Cerrar LanzadorScripts"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Margin="0,10,0,16"
                   Foreground="#9CA3AF"
                   Text="Al confirmar se detendran el backend local y las ejecuciones indicadas."
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Background="#171A21"
                BorderBrush="#343844"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <TextBlock x:Name="TextoSinEjecuciones"
                           Text="No hay scripts activos."
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <ListBox x:Name="ListaEjecuciones"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Ejecuciones}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,5">
                                <TextBlock Text="{Binding NombreScript}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Id}"
                                           Margin="0,3,0,0"
                                           Foreground="#6B7280"
                                           FontFamily="Consolas"
                                           FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    Width="100"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="Cancelar_Click" />
            <Button Content="Cerrar y cancelar scripts"
                    MinWidth="190"
                    Background="#7F1D1D"
                    BorderBrush="#EF4444"
                    IsDefault="True"
                    Click="Confirmar_Click" />
        </StackPanel>
    </Grid>
</Window>
